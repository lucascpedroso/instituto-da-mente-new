# Copie para .deploy.env (não versionado) e preencha com os dados do hPanel:
# Avançado > Acesso SSH
DEPLOY_HOST=000.000.000.000
DEPLOY_PORT=65002
DEPLOY_USER=u000000000
# Pasta da aplicação no servidor (fora do public_html)
DEPLOY_PATH=/home/u000000000/domains/SEU-DOMINIO.com.br/app
# Binário do PHP 8.3 no servidor (confira com `ls /opt/alt/`); "php" se já for 8.3
DEPLOY_PHP=php
# Se o composer usar outra versão do PHP: DEPLOY_COMPOSER="/opt/alt/php83/usr/bin/php /usr/local/bin/composer"
DEPLOY_COMPOSER=composer
